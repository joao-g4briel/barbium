// Schema do BARBIUM.
// DATABASE_URL = connection pooled do Neon (usada em runtime, via @prisma/adapter-neon).
// DIRECT_URL   = connection direta do Neon (usada só pelo Prisma Migrate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN // dono da plataforma BARBIUM, sem barbeariaId
  DONO // dono de uma barbearia
  BARBEIRO // barbeiro de uma barbearia
}

enum Plano {
  SOLO
  BARBEARIA
  REDE
}

enum StatusAgendamento {
  CONFIRMADO
  CONCLUIDO
  CANCELADO
  FALTA
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum PeriodicidadeAssinatura {
  MENSAL
  TRIMESTRAL
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

// Cada Barbearia é um tenant. Toda tabela "de negócio" carrega barbeariaId
// e é sempre filtrada por ele — é o que garante o isolamento multi-tenant.
model Barbearia {
  id        String   @id @default(cuid())
  nome      String
  slug      String   @unique
  telefone  String?
  plano     Plano    @default(SOLO)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios         Usuario[]
  unidades         Unidade[]
  clientes         Cliente[]
  servicos         Servico[]
  agendamentos     Agendamento[]
  caixaLancamentos CaixaLancamento[]

  @@map("barbearias")
}

// Só é usada de fato pelo plano Rede (múltiplas unidades por barbearia).
model Unidade {
  id          String   @id @default(cuid())
  nome        String
  endereco    String?
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())

  @@index([barbeariaId])
  @@map("unidades")
}

// Usuário com login: SUPER_ADMIN (barbeariaId nulo, plataforma inteira) ou
// DONO/BARBEIRO (sempre vinculado a uma barbearia).
model Usuario {
  id             String   @id @default(cuid())
  nome           String
  email          String   @unique
  senhaHash      String
  role           Role
  ativo          Boolean  @default(true)
  barbeariaId    String?
  barbearia      Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  comissaoPercentual Decimal? @db.Decimal(5, 2)
  criadoEm       DateTime @default(now())

  agendamentos Agendamento[] @relation("BarbeiroAgendamentos")
  expediente   ExpedienteDia[]
  bloqueios    BloqueioAgenda[]

  @@index([barbeariaId])
  @@map("usuarios")
}

// Expediente semanal do profissional: um registro por dia da semana.
// Horários guardados como texto "HH:mm" — evita lidar com fuso/data numa
// informação que é só "que horas", não um instante específico no tempo.
model ExpedienteDia {
  id           String    @id @default(cuid())
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  diaSemana    DiaSemana
  atende       Boolean   @default(true)
  horaInicio   String    @default("09:00")
  horaFim      String    @default("19:00")
  almocoInicio String?
  almocoFim    String?

  @@unique([usuarioId, diaSemana])
  @@map("expediente_dias")
}

// Bloqueio de agenda do profissional. Serve pra dois casos com o mesmo
// formato: um período já com data de volta definida (férias, folga) ou um
// bloqueio indefinido (fim = null) usado como trava de emergência — "não
// aceitar mais agendamentos a partir de agora", até alguém desativar.
model BloqueioAgenda {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  inicio    DateTime
  fim       DateTime?
  motivo    String?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, inicio])
  @@map("bloqueios_agenda")
}

// Cliente final da barbearia. Não tem login — é identificado por telefone
// no fluxo público de agendamento.
model Cliente {
  id          String   @id @default(cuid())
  nome        String
  telefone    String
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())

  // Assinatura simples: sem tabela própria, sem histórico — o vencimento é
  // a fonte da verdade, o status (em dia / vencida) é calculado comparando
  // com a data atual, não fica guardado. null em assinaturaVencimento
  // significa "nunca assinou ou cancelou".
  assinaturaTipo       PeriodicidadeAssinatura?
  assinaturaValor      Decimal?  @db.Decimal(10, 2)
  assinaturaVencimento DateTime?

  agendamentos Agendamento[]

  @@unique([barbeariaId, telefone])
  @@index([barbeariaId])
  @@map("clientes")
}

model Servico {
  id                 String   @id @default(cuid())
  nome               String
  duracaoMinutos     Int
  preco              Decimal  @db.Decimal(10, 2)
  comissaoPercentual Decimal? @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  barbeariaId        String
  barbearia          Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  agendamentos Agendamento[]

  @@index([barbeariaId])
  @@map("servicos")
}

model Agendamento {
  id          String            @id @default(cuid())
  inicio      DateTime
  fim         DateTime
  status      StatusAgendamento @default(CONFIRMADO)
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  servicoId   String
  servico     Servico  @relation(fields: [servicoId], references: [id])
  barbeiroId  String
  barbeiro    Usuario  @relation("BarbeiroAgendamentos", fields: [barbeiroId], references: [id])
  criadoEm    DateTime @default(now())

  caixaLancamento CaixaLancamento?

  @@index([barbeariaId, barbeiroId, inicio])
  @@map("agendamentos")
}

// Lançamento de caixa. Gerado automaticamente quando um agendamento é
// concluído (tipo ENTRADA), ou criado avulso pelo dono (ex.: uma despesa).
model CaixaLancamento {
  id            String         @id @default(cuid())
  tipo          TipoLancamento
  valor         Decimal        @db.Decimal(10, 2)
  descricao     String?
  barbeariaId   String
  barbearia     Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentoId String?   @unique
  agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id])
  criadoEm      DateTime  @default(now())

  @@index([barbeariaId, criadoEm])
  @@map("caixa_lancamentos")
}
