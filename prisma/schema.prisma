// Schema do BARBIUM.
// DATABASE_URL = connection pooled do Neon (usada em runtime, via @prisma/adapter-neon).
// DIRECT_URL   = connection direta do Neon (usada só pelo Prisma Migrate).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN // dono da plataforma BARBIUM, sem barbeariaId
  DONO // dono de uma barbearia
  BARBEIRO // barbeiro de uma barbearia
}

enum Plano {
  SOLO
  BARBEARIA
  REDE
}

enum StatusAgendamento {
  CONFIRMADO
  CHEGOU // o cliente chegou e está esperando
  EM_ATENDIMENTO // o atendimento começou
  CONCLUIDO
  CANCELADO
  FALTA
  AGUARDANDO_PAGAMENTO // horário reservado até o Pix do sinal ser pago (ou expirar)
}

enum SinalStatus {
  PENDENTE
  PAGO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  DEBITO
  CREDITO
}

// De onde veio o lançamento. Um agendamento pode ter até dois: o sinal (pago
// antes, pelo Pix) e o atendimento (o restante, pago na conclusão).
enum OrigemLancamento {
  MANUAL
  ATENDIMENTO
  SINAL
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

enum PeriodicidadeAssinatura {
  MENSAL
  TRIMESTRAL
}

enum DiaSemana {
  DOMINGO
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

// Cada Barbearia é um tenant. Toda tabela "de negócio" carrega barbeariaId
// e é sempre filtrada por ele — é o que garante o isolamento multi-tenant.
model Barbearia {
  id                   String         @id @default(cuid())
  nome                 String
  slug                 String         @unique
  telefone             String?
  // WhatsApp que recebe os avisos automáticos (novo agendamento etc.). Vazio:
  // vai pro telefone da barbearia. Separado porque o telefone da barbearia é
  // o de contato com clientes; o aviso costuma ir pro celular do dono.
  telefoneAvisos       String?
  // Quantas horas antes do horário o cliente recebe o lembrete no WhatsApp.
  // Vazio: não envia. Valores aceitos em src/lib/lembrete-opcoes.ts.
  lembreteHorasAntes   Int?
  plano                Plano          @default(SOLO)
  ativo                Boolean        @default(true)
  // Até quando a barbearia pode usar o painel. Vazio: sem prazo (barbearias
  // cadastradas ou liberadas pelo super admin). Cadastro pelo site começa
  // com o teste grátis; o pagamento empurra a data pra frente.
  acessoAte            DateTime?
  // Ainda no teste grátis (nunca pagou).
  emTeste              Boolean        @default(false)
  // Adicional de WhatsApp pago (ou liberado pela plataforma). No teste grátis
  // as mensagens saem mesmo sem ele. Regra em src/lib/whatsapp-adicional.ts.
  whatsappAtivo        Boolean        @default(false)
  // Avisos de fim do teste grátis já enviados ao dono (lib/avisos-teste.ts).
  avisoTesteAcabandoEm DateTime?
  avisoTesteFimEm      DateTime?
  // Página de agendamento: endereço, cor da marca (#rrggbb) e logo (imagem
  // na tabela barbearia_logos; a data serve pra renovar o cache da imagem).
  endereco             String?
  corMarca             String?
  logoAtualizadoEm     DateTime?
  logo                 BarbeariaLogo?
  criadoEm             DateTime       @default(now())
  atualizadoEm         DateTime       @updatedAt

  usuarios              Usuario[]
  pagamentosCakto       PagamentoCakto[]
  unidades              Unidade[]
  clientes              Cliente[]
  servicos              Servico[]
  agendamentos          Agendamento[]
  caixaLancamentos      CaixaLancamento[]
  configuracaoPagamento ConfiguracaoPagamento?

  @@map("barbearias")
}

// Cobrança de sinal via Mercado Pago (Pix). Tabela à parte pra que o token de
// acesso nunca venha junto nas consultas comuns da barbearia. O token é
// guardado cifrado (AES-256-GCM, chave em SEGREDOS_CHAVE), nunca em texto puro.
model ConfiguracaoPagamento {
  id                   String    @id @default(cuid())
  barbeariaId          String    @unique
  barbearia            Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  sinalAtivo           Boolean   @default(false)
  sinalPercentual      Int       @default(50)
  mpAccessTokenCifrado String?
  mpContaDescricao     String?
  atualizadoEm         DateTime  @updatedAt

  @@map("configuracoes_pagamento")
}

// Só é usada de fato pelo plano Rede (múltiplas unidades por barbearia).
model Unidade {
  id          String    @id @default(cuid())
  nome        String
  endereco    String?
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now())

  @@index([barbeariaId])
  @@map("unidades")
}

// Usuário com login: SUPER_ADMIN (barbeariaId nulo, plataforma inteira) ou
// DONO/BARBEIRO (sempre vinculado a uma barbearia).
model Usuario {
  id                 String     @id @default(cuid())
  nome               String
  email              String     @unique
  senhaHash          String
  role               Role
  ativo              Boolean    @default(true)
  barbeariaId        String?
  barbearia          Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  comissaoPercentual Decimal?   @db.Decimal(5, 2)
  criadoEm           DateTime   @default(now())
  // Sessões emitidas antes deste instante deixam de valer (troca/redefinição de senha).
  senhaAlteradaEm    DateTime?

  agendamentos          Agendamento[]           @relation("BarbeiroAgendamentos")
  expediente            ExpedienteDia[]
  bloqueios             BloqueioAgenda[]
  historicoAgendamentos AgendamentoHistorico[]
  tokensRedefinicao     TokenRedefinicaoSenha[]

  @@index([barbeariaId])
  @@map("usuarios")
}

// Link de "esqueci minha senha". Só o hash SHA-256 do token fica no banco: quem
// lê o banco não consegue montar um link válido. Vale uma vez, por pouco tempo.
model TokenRedefinicaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, criadoEm])
  @@map("tokens_redefinicao_senha")
}

// Expediente semanal do profissional: um registro por dia da semana.
// Horários guardados como texto "HH:mm" — evita lidar com fuso/data numa
// informação que é só "que horas", não um instante específico no tempo.
model ExpedienteDia {
  id           String    @id @default(cuid())
  usuarioId    String
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  diaSemana    DiaSemana
  atende       Boolean   @default(true)
  horaInicio   String    @default("09:00")
  horaFim      String    @default("19:00")
  almocoInicio String?
  almocoFim    String?

  @@unique([usuarioId, diaSemana])
  @@map("expediente_dias")
}

// Bloqueio de agenda do profissional. Serve pra dois casos com o mesmo
// formato: um período já com data de volta definida (férias, folga) ou um
// bloqueio indefinido (fim = null) usado como trava de emergência — "não
// aceitar mais agendamentos a partir de agora", até alguém desativar.
model BloqueioAgenda {
  id        String    @id @default(cuid())
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  inicio    DateTime
  fim       DateTime?
  motivo    String?
  criadoEm  DateTime  @default(now())

  @@index([usuarioId, inicio])
  @@map("bloqueios_agenda")
}

// Cliente final da barbearia. Não tem login — é identificado por telefone
// no fluxo público de agendamento.
model Cliente {
  id          String    @id @default(cuid())
  nome        String
  telefone    String
  barbeariaId String
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now())

  // Assinatura simples: sem tabela própria, sem histórico — o vencimento é
  // a fonte da verdade, o status (em dia / vencida) é calculado comparando
  // com a data atual, não fica guardado. null em assinaturaVencimento
  // significa "nunca assinou ou cancelou".
  assinaturaTipo       PeriodicidadeAssinatura?
  assinaturaValor      Decimal?                 @db.Decimal(10, 2)
  assinaturaVencimento DateTime?

  // O cliente pode pedir pra não receber as mensagens automáticas de WhatsApp.
  aceitaMensagens Boolean   @default(true)
  // Excluído pela barbearia com atendimentos pagos no histórico: nome e
  // telefone são apagados (anonimização) e o registro fica só pra caixa e
  // comissões continuarem batendo. Some das listas e da busca.
  removidoEm      DateTime?

  agendamentos Agendamento[]

  @@unique([barbeariaId, telefone])
  @@index([barbeariaId])
  @@map("clientes")
}

model Servico {
  id                 String    @id @default(cuid())
  nome               String
  duracaoMinutos     Int
  preco              Decimal   @db.Decimal(10, 2)
  comissaoPercentual Decimal?  @db.Decimal(5, 2)
  ativo              Boolean   @default(true)
  barbeariaId        String
  barbearia          Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)

  agendamentos Agendamento[]

  @@index([barbeariaId])
  @@map("servicos")
}

model Agendamento {
  id          String            @id @default(cuid())
  inicio      DateTime
  fim         DateTime
  status      StatusAgendamento @default(CONFIRMADO)
  barbeariaId String
  barbearia   Barbearia         @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  clienteId   String
  cliente     Cliente           @relation(fields: [clienteId], references: [id])
  servicoId   String
  servico     Servico           @relation(fields: [servicoId], references: [id])
  barbeiroId  String
  barbeiro    Usuario           @relation("BarbeiroAgendamentos", fields: [barbeiroId], references: [id])
  criadoEm    DateTime          @default(now())

  // Sinal antecipado (só preenchido quando a barbearia cobra sinal).
  sinalValor       Decimal?     @db.Decimal(10, 2)
  sinalStatus      SinalStatus?
  sinalPagamentoId String?
  sinalExpiraEm    DateTime?
  sinalPagoEm      DateTime?
  // A barbearia devolveu o sinal pelo Mercado Pago (a entrada sai do caixa).
  sinalDevolvidoEm DateTime?

  // Comissão do profissional, calculada e guardada na conclusão: mudar o
  // percentual depois não altera atendimentos já fechados.
  comissaoPercentual Decimal? @db.Decimal(5, 2)
  comissaoValor      Decimal? @db.Decimal(10, 2)

  // Quando o lembrete foi tratado (enviado, ou dispensado porque não fazia
  // sentido). Garante um lembrete só por horário; mudar o horário zera.
  lembreteEnviadoEm DateTime?

  caixaLancamentos CaixaLancamento[]
  historico        AgendamentoHistorico[]

  @@index([barbeariaId, barbeiroId, inicio])
  @@index([status, sinalExpiraEm])
  @@map("agendamentos")
}

// Lançamento de caixa. Gerado automaticamente quando um sinal é pago (SINAL)
// e quando um agendamento é concluído (ATENDIMENTO, o restante), ou criado
// avulso pelo dono (MANUAL, ex.: uma despesa).
model CaixaLancamento {
  id             String           @id @default(cuid())
  tipo           TipoLancamento
  valor          Decimal          @db.Decimal(10, 2)
  descricao      String?
  barbeariaId    String
  barbearia      Barbearia        @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  agendamentoId  String?
  agendamento    Agendamento?     @relation(fields: [agendamentoId], references: [id])
  origem         OrigemLancamento @default(MANUAL)
  formaPagamento FormaPagamento?
  criadoEm       DateTime         @default(now())

  @@unique([agendamentoId, origem])
  @@index([barbeariaId, criadoEm])
  @@map("caixa_lancamentos")
}

// Contador de tentativas por chave (ex.: "login:email:fulano@x.com",
// "agendar:ip:1.2.3.4"), numa janela de tempo fixa. Freia força bruta no login
// e enxurrada de agendamentos falsos no link público, sem serviço externo.
model LimiteTentativa {
  chave    String   @id
  contagem Int
  expiraEm DateTime

  @@index([expiraEm])
  @@map("limites_tentativas")
}

enum AcaoHistorico {
  CRIADO
  STATUS
  HORARIO
  SERVICO
}

// Quem fez o quê num agendamento, e quando. Só cresce: nada aqui é editado.
model AgendamentoHistorico {
  id            String             @id @default(cuid())
  agendamentoId String
  agendamento   Agendamento        @relation(fields: [agendamentoId], references: [id], onDelete: Cascade)
  acao          AcaoHistorico
  statusDe      StatusAgendamento?
  statusPara    StatusAgendamento?
  // Texto pronto pra tela, ex.: "qui 26/11 09:00 → sex 27/11 10:30".
  detalhe       String?
  // Quem fez: alguém da equipe (usuarioId) ou o cliente / o sistema (sem usuário).
  usuarioId     String?
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  // Nome na hora, pra continuar legível mesmo se a pessoa mudar de nome.
  autor         String
  criadoEm      DateTime           @default(now())

  @@index([agendamentoId, criadoEm])
  @@map("agendamento_historico")
}

// Pagamentos recebidos da Cakto pelo webhook (lib/cakto.ts). O id é o pedido
// na Cakto: o mesmo pedido nunca libera acesso duas vezes.
model PagamentoCakto {
  id          String     @id
  evento      String
  barbeariaId String?
  barbearia   Barbearia? @relation(fields: [barbeariaId], references: [id], onDelete: SetNull)
  ofertaId    String?
  tipoOferta  String?
  valor       Decimal?   @db.Decimal(10, 2)
  email       String?
  resultado   String
  criadoEm    DateTime   @default(now())

  @@index([barbeariaId])
  @@map("cakto_pagamentos")
}

// Logo da barbearia (já reduzido no navegador, até 200 KB), fora da tabela
// principal pra não pesar nas consultas da barbearia.
model BarbeariaLogo {
  barbeariaId String    @id
  barbearia   Barbearia @relation(fields: [barbeariaId], references: [id], onDelete: Cascade)
  dados       Bytes
  tipo        String

  @@map("barbearia_logos")
}
