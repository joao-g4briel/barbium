# Neon injeta DATABASE_URL e DIRECT_URL automaticamente quando você conecta
# o projeto Neon ao projeto Vercel (integração nativa). Pra rodar local, copie
# as duas do painel do Neon: DATABASE_URL é a pooled connection, DIRECT_URL é
# a unpooled (usada pelo Prisma Migrate).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.neon.tech/barbium?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.neon.tech/barbium?sslmode=require"

# Segredo usado pra assinar o JWT de sessão. Gere um valor aleatório forte,
# por exemplo: openssl rand -base64 32
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-forte"

# Usados só pelo prisma/seed.ts, pra criar o primeiro usuário SUPER_ADMIN.
SUPER_ADMIN_NOME="Seu Nome"
SUPER_ADMIN_EMAIL="voce@barbium.com.br"
SUPER_ADMIN_SENHA="escolha-uma-senha-forte-aqui"

# Chave que cifra credenciais de terceiros guardadas no banco (ex.: Access
# Token do Mercado Pago usado no sinal via Pix). 32 bytes em base64, gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (ou openssl rand -base64 32, onde houver openssl) — e não troque depois de
# salvar tokens, ou eles deixam de poder ser lidos (será preciso colar o token de novo).
SEGREDOS_CHAVE="gere-com-openssl-rand-base64-32"
